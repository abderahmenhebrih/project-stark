# STARK environment template.
# Copy to `.env` for local development. Values below are placeholders only.
# No real secrets, provider keys, or Supabase credentials belong here.

# Example (unused for now):
# STARK_ENV=development

# Optional STARK account (Stage 29): public Supabase client
# configuration only. Never a service_role key, database password,
# or management token. Absent values keep local STARK fully usable
# with cloud account features reported as unavailable.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-key
