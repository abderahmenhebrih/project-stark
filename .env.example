# STARK local development configuration (EXAMPLE — copy to .env.local, never commit secrets)
#
# 1. Copy this file to `.env.local` in the project root.
# 2. Fill in YOUR Supabase project's public values.
# 3. Never commit `.env.local` (it is git-ignored).
#
# PUBLIC ANON KEY ONLY. NEVER use a service_role key here: the desktop
# client authenticates with the public anon key, and startup refuses
# service-role-shaped configuration fail-closed.

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Your Supabase public anon key (publishable key). NEVER service_role.
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Informational: STARK always uses stark://auth/callback for OAuth.
# This value is fixed in code; no override is honored.
STARK_AUTH_REDIRECT_URL=stark://auth/callback
