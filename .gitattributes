# STARK repository line-ending policy (Phase A hygiene).
#
# Intent: deterministic LF in the repository for all text, regardless of
# developer OS / core.autocrlf. Windows checkouts may still use CRLF on
# disk when core.autocrlf=true; content hashes normalized to LF are stable.
# Binary assets are never normalized.
* text=auto

# Source / config / docs: LF in repo.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.svg text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.editorconfig text eol=lf

# Windows batch requires CRLF to execute reliably.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary: never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.node binary
*.vsix binary
*.zip binary
*.db binary
*.sqlite binary
